{
  "$schema": "node_modules/wrangler/config-schema.json",
  // The public hostname is <name>.<account subdomain>.workers.dev, so this is the half of
  // the shared link that is set here. The account subdomain is dashboard-only.
  "name": "builderday",
  "main": "src/index.tsx",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // Frontend and API in one deployment unit. Static files in ./public are served
  // directly; everything else falls through to the Worker.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "none"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "secc-builder-day",
      // Replace with the id printed by: wrangler d1 create secc-builder-day
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],

  // Runs hourly; the handler itself decides whether it is 09:00 on a weekday in the
  // event's local timezone. Keeps the timezone a config value rather than a cron edit.
  "triggers": {
    "crons": ["0 * * * *"]
  },

  "vars": {
    "EVENT_NAME": "SECC Inaugural AI Builder's Day",
    "EVENT_DATE": "2026-09-22",
    "FORM_OPENS": "2026-08-01T09:00:00+08:00",
    "FORM_DEADLINE": "2026-09-15T17:00:00+08:00",
    "LOCAL_UTC_OFFSET_HOURS": "8",
    "REMINDER_LOCAL_HOUR": "9",
    "ORGANIZER_EMAILS": "",
    // Left empty on purpose: links are built from the request origin, so a fresh
    // deploy is correct with no configuration. Set it only if you send email, since the
    // reminder cron has no request to read an origin from.
    "PUBLIC_ORIGIN": "",
    "FROM_EMAIL": "AI Builder Day <builderday@example.org>",
    "MAX_REMINDERS": "2",
    "EXPECTED_PARTICIPANTS": "80",
    "ANTHROPIC_MODEL": "claude-sonnet-5",
    "AI_GATEWAY_URL": "",
    "TURNSTILE_SITE_KEY": "",
    "DEV_ADMIN_EMAIL": "organizer@example.org"
  }
}

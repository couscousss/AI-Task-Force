// The ORGANIZER Worker. Deployed separately from the public one so that Cloudflare
// Access can be switched on for the whole of it — see src/admin.tsx for why.
//
// Same D1 database as the public Worker, so there is one copy of the data.
//
// PUBLIC_ORIGIN must point at the PUBLIC Worker: it is what the "link to share" on the
// dashboard and every personal link in the participants table are built from. The deploy
// workflow overwrites it with the real URL, so it stays right even if that Worker is
// renamed.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "secc-builder-day-admin",
  "main": "src/admin.tsx",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // Frontend and API in one deployment unit. Static files in ./public are served
  // directly; everything else falls through to the Worker.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "none"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "secc-builder-day",
      // Replace with the id printed by: wrangler d1 create secc-builder-day
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],


  "vars": {
    "EVENT_NAME": "SECC AI Builder Day",
    "EVENT_DATE": "2026-09-22",
    "FORM_OPENS": "2026-08-01T09:00:00+08:00",
    "FORM_DEADLINE": "2026-09-15T17:00:00+08:00",
    "LOCAL_UTC_OFFSET_HOURS": "8",
    "REMINDER_LOCAL_HOUR": "9",
    "ORGANIZER_EMAILS": "",
    // Left empty on purpose: links are built from the request origin, so a fresh
    // deploy is correct with no configuration. Set it only if you send email, since the
    // reminder cron has no request to read an origin from.
    "PUBLIC_ORIGIN": "https://secc-builder-day.marcusfoo-work.workers.dev",
    "FROM_EMAIL": "AI Builder Day <builderday@example.org>",
    "MAX_REMINDERS": "2",
    "EXPECTED_PARTICIPANTS": "80",
    "ANTHROPIC_MODEL": "claude-sonnet-5",
    "AI_GATEWAY_URL": "",
    "TURNSTILE_SITE_KEY": "",
    "DEV_ADMIN_EMAIL": "organizer@example.org"
  }
}
